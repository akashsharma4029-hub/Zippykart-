@import url('https://fonts.googleapis.com/css2?family=Montserrat:wght=400;600;700;900&display=swap');
* { margin: 0; padding: 0; box-sizing: border-box; font-family: 'Montserrat', sans-serif; }
body { background-color: #f1f2f4; color: #111; overflow-x: hidden; padding-bottom: 40px; }
header { background-color: #111; color: #fff; padding: 15px 6%; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 1000; width: 100vw; box-shadow: 0 4px 20px rgba(0,0,0,0.15); }
.header-left-block { display: flex; align-items: center; gap: 30px; flex-grow: 1; }
.logo { font-size: 25px; font-weight: 900; text-transform: uppercase; letter-spacing: -0.5px; cursor: pointer; display: flex; align-items: center; }
.logo .zippy { color: #fff; }
.logo .kart { background: linear-gradient(135deg, #ff3e3e, #ff7e40); color: #111; padding: 2px 10px; border-radius: 4px; margin-left: 2px; transform: skewX(-10deg); display: inline-block; box-shadow: 0 0 10px rgba(255, 62, 62, 0.4); }
.search-web-wrapper { display: flex; align-items: center; background: #222; border-radius: 6px; padding: 10px 15px; width: 45%; max-width: 500px; position: relative; border: 1px solid #333; }
.search-web-wrapper input { border: none; outline: none; width: 85%; font-size: 13px; font-weight: 500; color: #fff; background: transparent; }
.search-web-wrapper input::placeholder { color: #666; }
.search-web-wrapper i.fa-magnifying-glass { color: #666; margin-right: 12px; }
.search-web-wrapper i.fa-camera { color: #aaa; cursor: pointer; font-size: 16px; position: absolute; right: 15px; }
.header-right-menu { display: flex; align-items: center; gap: 20px; }
.nav-dropdown-item { position: relative; display: inline-block; cursor: pointer; font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px; color: #fff; padding: 10px 12px; border-radius: 4px; }
.nav-dropdown-item:hover { background: #222; }
.floating-menu-pane { display: none; position: absolute; top: 100%; right: 0; background: #fff; min-width: 265px; box-shadow: 0 15px 35px rgba(0,0,0,0.2); border-radius: 8px; border: 1px solid #e8e8e8; overflow: hidden; z-index: 2000; margin-top: 8px; animation: smoothPopupReveal 0.25s ease; }
.nav-dropdown-item:hover .floating-menu-pane { display: block; }
@keyframes smoothPopupReveal { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
.menu-row { display: flex; justify-content: space-between; align-items: center; padding: 14px 20px; color: #222; font-size: 12px; font-weight: 600; text-decoration: none; border-bottom: 1px solid #f6f6f6; transition: all 0.2s; text-transform: none; }
.menu-row:hover { background: #fff5f5; color: #ff3e3e; padding-left: 24px; }
.menu-row .left-side-cap { display: flex; align-items: center; gap: 12px; }
.menu-row i.row-lead-ico { color: #ff3e3e; font-size: 15px; width: 20px; text-align: center; }
.notification-toggle-box { display: flex; flex-direction: column; gap: 8px; padding: 15px 20px; background: #fdfdfd; border-top: 1px solid #eee; text-transform: none; }
.toggle-header-row { display: flex; justify-content: space-between; align-items: center; }
.toggle-header-row span { font-size: 13px; font-weight: 700; color: #111; }
.switch-engine-chassis { position: relative; display: inline-block; width: 42px; height: 24px; }
.switch-engine-chassis input { opacity: 0; width: 0; height: 0; }
.slider-knob-fluid { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; transition: .3s; border-radius: 24px; }
.slider-knob-fluid:before { position: absolute; content: ""; height: 18px; width: 18px; left: 3px; bottom: 3px; background-color: white; transition: .3s; border-radius: 50%; }
input:checked + .slider-knob-fluid { background-color: #ff3e3e; }
input:checked + .slider-knob-fluid:before { transform: translateX(18px); }
.notification-toggle-box p { font-size: 11px; color: #888; margin-top: -2px; }
.web-cart-btn { background: linear-gradient(135deg, #ff3e3e, #ff7e40); color: #fff; border: none; padding: 10px 20px; border-radius: 4px; font-weight: bold; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 12px; text-transform: uppercase; }
.top-delivery-strip { background: #1a1a1a; color: #aaa; padding: 12px 6%; display: flex; justify-content: space-between; align-items: center; font-size: 11px; font-weight: 600; width: 100vw; }
.addr-left { display: flex; align-items: center; gap: 8px; cursor: pointer; color: #fff; max-width: 75%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.addr-left i { color: #ff3e3e; }
.supercoins-panel { display: flex; align-items: center; gap: 6px; background: rgba(255,229,0,0.1); border: 1px solid #ffe500; color: #ffe500; padding: 3px 12px; border-radius: 12px; }
.categories-bar { background: #fff; padding: 15px 6%; display: flex; gap: 15px; overflow-x: auto; box-shadow: 0 2px 5px rgba(0,0,0,0.02); width: 100vw; border-bottom: 1px solid #eee; }
.categories-bar::-webkit-scrollbar { display: none; }
.cat-item { background: #f3f3f3; color: #333; padding: 8px 20px; border-radius: 20px; font-size: 11px; font-weight: 600; text-transform: uppercase; cursor: pointer; white-space: nowrap; transition: all 0.2s; }
.cat-item.active, .cat-item:hover { background: #111; color: #fff; }
.slider-wrapper { position: relative; width: 100vw; height: 52vh; min-height: 350px; max-height: 520px; overflow: hidden; background: #111; }
.slide-container { display: flex; width: 500%; height: 100%; transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
.slide-frame { width: 100vw; height: 100%; position: relative; cursor: pointer; }
.slide-frame img { width: 100%; height: 100%; object-fit: cover; object-position: center; display: block; }
.banner-overlay-text { position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: linear-gradient(90deg, rgba(0,0,0,0.65) 0%, rgba(0,0,0,0.2) 100%); display: flex; flex-direction: column; justify-content: center; padding-left: 8%; color: #fff; z-index: 5; }
.banner-overlay-text h1 { font-size: 42px; font-weight: 900; text-transform: uppercase; line-height: 1.1; letter-spacing: -0.5px; }
.banner-overlay-text p { font-size: 14px; margin-top: 8px; color: #ddd; font-weight: 500; }
.container { width: 100vw; max-width: 100%; padding: 35px 6%; min-height: 500px; }
.section-title { font-size: 16px; font-weight: 900; text-transform: uppercase; margin-bottom: 25px; color: #111; }
.section-title::after { content: ''; display: block; width: 35px; height: 3px; background: #ff3e3e; margin-top: 6px; }
.grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 20px; width: 100%; }
@media (max-width: 1300px) { .grid { grid-template-columns: repeat(4, 1fr); } }
@media (max-width: 950px) { .grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 650px) { .grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
.card { background: #fff; padding: 16px; border-radius: 8px; border: 1px solid #eaeaea; display: flex; flex-direction: column; justify-content: space-between; position: relative; box-shadow: 0 4px 15px rgba(0,0,0,0.02); cursor: pointer; }
.card .img-container { width: 100%; height: 260px; overflow: hidden; border-radius: 6px; margin-bottom: 12px; background: #fafafa; }
.card .img-container img { width: 100%; height: 100%; object-fit: cover; }
.card h3 { font-size: 13px; font-weight: 700; margin-bottom: 6px; color: #212121; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.price-box { margin-bottom: 12px; display: flex; align-items: center; gap: 8px; font-size: 13px; }
.price-box .now { font-weight: 700; color: #111; font-size: 15px; }
.price-box .old { text-decoration: line-through; color: #878787; font-size: 12px; }
.price-box .off { color: #ff3e3e; font-weight: bold; font-size: 12px; }
.buy-btn { background: #111; color: #fff; font-size: 11px; font-weight: bold; padding: 11px; border-radius: 4px; cursor: pointer; border: none; width: 100%; text-transform: uppercase; }
.custom-popup-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 4000; display: none; justify-content: center; align-items: center; backdrop-filter: blur(4px); }
.popup-modal-card { background: #fff; border-radius: 12px; width: 90%; max-width: 450px; box-shadow: 0 20px 50px rgba(0,0,0,0.3); animation: zoomReveal 0.25s ease; overflow: hidden; }
@keyframes zoomReveal { from { transform: scale(0.9); opacity: 0; } to { transform: scale(1); opacity: 1; } }
.popup-modal-header { background: #111; color: #fff; padding: 18px 20px; display: flex; justify-content: space-between; align-items: center; font-weight: 700; font-size: 15px; }
.popup-modal-body { padding: 25px 20px; font-size: 13px; color: #444; line-height: 1.5; }
.auth-master-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.6); z-index: 5000; display: none; justify-content: center; align-items: center; backdrop-filter: blur(3px); }
.auth-window-box { background: #fff; width: 92%; max-width: 800px; height: 78vh; border-radius: 12px; display: flex; overflow: hidden; position: relative; box-shadow: 0 25px 60px rgba(0,0,0,0.4); animation: slideModalUp 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
@keyframes slideModalUp { from { transform: translateY(30px); opacity: 0; } to { transform: translateY(0); opacity: 1; } }
.auth-left-banner { width: 38%; background: linear-gradient(135deg, #111 0%, #222 100%); padding: 40px 30px; color: #fff; display: flex; flex-direction: column; justify-content: space-between; }
.auth-left-banner h2 { font-size: 24px; font-weight: 900; text-transform: uppercase; }
.auth-left-banner p { font-size: 13px; color: #aaa; margin-top: 10px; line-height: 1.5; }
.auth-right-form-hub { width: 62%; padding: 35px 40px; overflow-y: auto; display: flex; flex-direction: column; justify-content: space-between; }
.auth-switch-link-row { font-size: 13px; font-weight: 600; color: #555; }
.auth-switch-link-row span.blue-link-trigger { color: #0076e4; cursor: pointer; font-weight: 700; text-decoration: underline; margin-left: 4px; }
.auth-form-fields-container { display: flex; flex-direction: column; gap: 12px; margin-top: 12px; }
.auth-input-cell { display: flex; flex-direction: column; gap: 4px; }
.auth-input-cell label { font-size: 10px; font-weight: 700; color: #878787; text-transform: uppercase; }
.auth-input-cell input { padding: 10px 14px; border: 1px solid #d4d5d9; border-radius: 4px; font-size: 13px; font-weight: 600; outline: none; }
.auth-action-submit-btn { background: #fb641b; color: #fff; border: none; padding: 13px; border-radius: 4px; font-size: 13px; font-weight: 700; text-transform: uppercase; width: 100%; cursor: pointer; margin-top: 12px; }
.auth-google-divider-block { display: flex; align-items: center; text-align: center; color: #878787; font-size: 11px; font-weight: 600; margin: 15px 0; text-transform: uppercase; }
.auth-google-divider-block::before, .auth-google-divider-block::after { content: ''; flex: 1; border-bottom: 1px solid #e0e0e0; }
.google-btn-flex-chassis { display: flex; justify-content: center; width: 100%; }
.detail-modal-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.7); z-index: 3000; display: none; justify-content: center; align-items: center; backdrop-filter: blur(5px); }
.detail-modal-box { background: #fff; width: 92%; max-width: 850px; height: 82vh; border-radius: 12px; display: flex; overflow: hidden; position: relative; }
.detail-left { width: 45%; background: #fafafa; display: flex; align-items: center; justify-content: center; padding: 20px; border-right: 1px solid #eee; }
.detail-left img { max-width: 100%; max-height: 100%; object-fit: contain; }
.detail-right { width: 55%; padding: 30px; overflow-y: auto; display: flex; flex-direction: column; gap: 20px; }
.review-section { border-top: 1px solid #eee; padding-top: 20px; }
.star-rating-input { display: flex; gap: 6px; margin: 10px 0; }
.star-rating-input i { font-size: 22px; color: #ccc; cursor: pointer; }
.star-rating-input i.active { color: #ffb400; }
.review-input-box { width: 100%; padding: 12px; border: 1px solid #ccc; border-radius: 6px; font-size: 12px; resize: none; outline: none; }
.upload-photo-btn { background: #f5f5f5; padding: 10px 14px; border: 1px solid #ddd; border-radius: 4px; font-size: 11px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; margin: 10px 0; }
.upload-photo-btn input { display: none; }
.review-submit-btn { background: #111; color: #fff; padding: 9px 24px; border: none; border-radius: 4px; font-size: 11px; font-weight: bold; cursor: pointer; text-transform: uppercase; }
.live-reviews-display { display: flex; flex-direction: column; gap: 12px; margin-top: 15px; }
.single-review-card { background: #fafafa; padding: 14px; border-radius: 6px; border: 1px solid #eee; font-size: 12px; }
.review-stars-active { color: #ffb400; margin-bottom: 5px; }
.review-attached-img { max-width: 90px; max-height: 90px; object-fit: cover; border-radius: 4px; margin-top: 8px; display: block; border: 1px solid #ddd; }
.cart-up-sheet { position: fixed; bottom: -100%; left: 0; width: 100%; height: 75vh; background: #fff; border-radius: 20px 20px 0 0; box-shadow: 0 -5px 25px rgba(0,0,0,0.15); z-index: 2500; transition: bottom 0.4s; display: flex; flex-direction: column; }
.cart-up-sheet.sheet-active { bottom: 0; }
.sheet-header { padding: 20px 6%; border-bottom: 1px solid #eee; display: flex; justify-content: space-between; align-items: center; }
.sheet-body { padding: 20px 6%; flex-grow: 1; overflow-y: auto; }
.sheet-footer { padding: 20px 6%; border-top: 1px solid #eee; background: #fafafa; display: flex; justify-content: space-between; align-items: center; }
.final-pay-btn { background: #ff5722; color: #fff; border: none; padding: 12px 40px; border-radius: 4px; font-size: 13px; font-weight: bold; text-transform: uppercase; cursor: pointer; }
.sheet-overlay { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.5); z-index: 2200; display: none; }
